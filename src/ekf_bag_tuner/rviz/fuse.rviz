Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.05
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Odometry
      Name: ZED
      Enabled: true
      Topic:
        Value: /zed/zed_node/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 500
      Shape:
        Value: Arrow
      Color: 0; 100; 255
    - Class: rviz_default_plugins/Odometry
      Name: LidarOdom
      Enabled: true
      Topic:
        Value: /lidar/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 500
      Shape:
        Value: Arrow
      Color: 0; 200; 0
    - Class: rviz_default_plugins/Pose
      Name: Fused
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 50; 50
      Arrow Length: 0.35
  Global Options:
    Fixed Frame: odom_fused
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 20
      X: 0
      Y: 0
Window Geometry:
  Height: 800
  Width: 1200
